.DS_Store

# data_cache/ — MATLAB ground-truth exports + pydynamo intermediate dumps.
# Big (~2.7 GB). Regenerable via scripts/export_*.m + running the pipeline.
# We keep only the small, human-readable summary artifacts (BISECT_SUMMARY.md,
# bisect_full_report.{json,txt}) and the stitched side-by-side PNGs.
data_cache/*.mat
data_cache/*.csv
data_cache/*.npz
# Per-side intermediate comparison PNGs (regenerated by
# scripts/compare_matlab_vs_pydynamo.py). Keep only the stitched side-by-side.
data_cache/compare_*_matlab.png
data_cache/compare_*_pydynamo.png
!data_cache/.gitkeep
